// DDD role: PersistenceSchema
// Canonical SQLite physical schema for the K8sManager local store.
// Reference: ADR-0010 (local-persistence-sqlite-keychain).
//
// Storage path: ~/.config/k8smanager/storage.sqlite3
//   (ADR-0026 moves root from ~/Library/Application Support/; ADR-0010 rules
//   carry forward unchanged.)
//
// PRAGMAs applied at every connection open:
//   PRAGMA journal_mode=WAL;
//   PRAGMA synchronous=NORMAL;
//   PRAGMA foreign_keys=ON;
//   PRAGMA busy_timeout=5000;
//   PRAGMA cache_size=-65536;   -- ~64 MiB page cache
//   PRAGMA wal_autocheckpoint=1000;
//
// Schema evolution: append-only numbered migrations, each a Swift function
// running inside a single GRDB transaction. Version is pinned in the
// `schema_migrations` table. Down-migration is not supported.
//
// Security boundary:
//   - LLM API keys, OIDC refresh tokens, and Azure tokens live in the
//     macOS Keychain only (three namespaces per ADR-0010 refinement note).
//   - Per-cluster JSON view state lives under
//     ~/.config/k8smanager/clusters/<clusterId>/ — NOT in this database.
//   - No row in any table may contain an API key value or raw token.

Project k8s_manager_storage {
  database_type: "SQLite"
  Note: "Single-file local store for chat history, provider profiles, cluster-analysis cache, mutation audit, editor drafts, MCP wire log, operator preferences, and trusted exec-plugin registry. Secrets remain in macOS Keychain (ADR-0010). Per-cluster view state is in JSON files (ADR-0025, ADR-0026)."
}

// ---------------------------------------------------------------------------
// Table definitions
// ---------------------------------------------------------------------------

Table schema_migrations {
  version int [pk, note: "Strictly monotonic integer. Identifies the highest applied migration."]
  applied_at varchar [not null, note: "RFC 3339 timestamp of when the migration completed."]
  description varchar [not null, note: "Human-readable label matching the Swift function name, e.g. 'v1_initial_schema'."]

  Note: "Append-only ledger of applied migrations. The application asserts on launch that the stored version matches the highest migration registered in the Swift migrator. Reference: ADR-0010."
}

Table chat_sessions {
  id varchar [pk, note: "UUIDv7 — lexicographically sortable by creation time."]
  created_at varchar [not null, note: "RFC 3339."]
  updated_at varchar [not null, note: "RFC 3339; updated on every message append."]
  title varchar [null, note: "User-visible label; null until the assistant infers one."]
  provider_profile_id varchar [null, note: "UUIDv7. FK to the LLM profile used in this session. Nullable so sessions survive profile deletion. Delete action: set null (see Ref block at end of file)."]
  cluster_id varchar [null, note: "UUIDv7 of the pinned cluster. No FK — cluster state is managed in per-cluster JSON files (ADR-0025)."]
  archived_at varchar [null, note: "RFC 3339. Null while active. Set to indicate the session was archived by the operator."]

  Indexes {
    (provider_profile_id) [name: "idx_chat_sessions_provider"]
    (archived_at) [name: "idx_chat_sessions_archived"]
  }

  Note: "Represents one continuous conversation between the operator and the LLM assistant. Provider profile and cluster are soft references — the session record survives profile or cluster deletion. Reference: ADR-0010, assistant_chat bounded context."
}

Table chat_messages {
  id varchar [pk, note: "UUIDv7."]
  session_id varchar [not null, note: "UUIDv7. FK to the owning session. Delete action: cascade (see Ref block at end of file)."]
  role varchar [not null, note: "'system' | 'user' | 'assistant' | 'tool'"]
  content text [not null, note: "Full message content. For tool results this is the rendered output."]
  tool_calls_json text [null, note: "Serialised tool-call array for assistant turns. Redacted per the secret_redaction policy (ADR-0027) before storage; field is null for non-assistant roles."]
  created_at varchar [not null, note: "RFC 3339."]

  Indexes {
    (session_id, created_at) [name: "idx_chat_messages_session_time"]
  }

  Note: "Ordered log of all messages in a chat session. The (session_id, created_at) index supports efficient chronological retrieval. tool_calls_json is subject to the redaction policy — any credential-shaped value is scrubbed before the row commits. Reference: ADR-0010, ADR-0027."
}

Table provider_profiles {
  id varchar [pk, note: "UUIDv7."]
  kind varchar [not null, note: "'anthropic' | 'openai' | 'openai-compatible'"]
  display_name varchar [not null, note: "Operator-visible label shown in the profile picker."]
  endpoint_url varchar [not null, note: "API base URL. For Anthropic this is https://api.anthropic.com; for openai-compatible it is the custom host."]
  model varchar [not null, note: "Model identifier string, e.g. 'claude-opus-4-7' or 'gpt-4o'."]
  temperature real [null, note: "Sampling temperature override. Null means use the provider default."]
  key_alias varchar [not null, note: "Keychain account slug under service='com.archanjo.K8sManager.llm'. Never the key value itself."]
  local_only boolean [not null, default: false, note: "True for Ollama / LM Studio profiles that require no network key."]
  created_at varchar [not null, note: "RFC 3339."]
  updated_at varchar [not null, note: "RFC 3339."]

  Indexes {
    (kind) [name: "idx_provider_profiles_kind"]
  }

  Note: "Describes a single LLM provider configuration. The actual API key is held exclusively in the macOS Keychain entry identified by key_alias (service='com.archanjo.K8sManager.llm', account=key_alias). Reference: ADR-0008, ADR-0010."
}

Table cluster_analysis_cache {
  id varchar [pk, note: "UUIDv7."]
  cluster_id varchar [not null, note: "UUIDv7 of the target cluster. No FK — cluster registry lives outside SQLite."]
  kind varchar [not null, note: "Analysis kind discriminator, e.g. 'cluster_summary' | 'node_pressure' | 'rollout_history' | 'workload_topology' | 'recent_events_digest'."]
  payload_json text [not null, note: "Full JSON payload produced by the intelligence analysis step."]
  expires_at_rfc3339 varchar [not null, note: "RFC 3339. Rows past this timestamp are eligible for pruning by the vacuum task."]
  created_at varchar [not null, note: "RFC 3339."]

  Indexes {
    (cluster_id, expires_at_rfc3339) [name: "idx_analysis_cache_cluster_expiry"]
  }

  Note: "TTL-bounded cache of LLM-generated cluster analyses. The vacuum task prunes rows where expires_at_rfc3339 < now(). The (cluster_id, expires_at_rfc3339) index supports both lookup by cluster and batch-expiry scans. Reference: ADR-0010, cluster_intelligence bounded context."
}

Table operator_preferences {
  key varchar [pk, note: "Dot-separated preference key, e.g. 'theme' | 'locale' | 'sidebar.width'."]
  value_json text [not null, note: "JSON-encoded value. Examples: key='theme', value_json='\"system\"'; key='locale', value_json='\"en-US\"'; key='sidebar.width', value_json='320'."]
  updated_at varchar [not null, note: "RFC 3339."]

  Note: "Schemaless key/value store for application-level preferences. Consumed via OperatorPreferencesPort by the app_shell bounded context. Reference: ADR-0010."
}

Table editor_drafts {
  id varchar [pk, note: "UUIDv7."]
  editor_session_id varchar [not null, note: "UUIDv7 of the EditorSession that produced this draft. No FK — editor sessions are transient in-memory objects."]
  resource_ref_json text [null, note: "JSON-encoded ResourceRef (apiVersion, kind, namespace, name). Null for new resources not yet applied."]
  source_format varchar [not null, note: "'yaml' | 'json' | 'markdown'"]
  content text [not null, note: "Full buffer content at the time of the auto-save snapshot."]
  sensitive_content_redacted boolean [not null, default: false, note: "True when the content field was sanitised by the redaction policy before storage."]
  saved_at varchar [not null, note: "RFC 3339. Used for age-based pruning."]
  auto_saved boolean [not null, default: true, note: "False when the snapshot was triggered by an explicit operator save action."]

  Indexes {
    (editor_session_id, saved_at) [name: "idx_editor_drafts_session_time"]
  }

  Note: "Point-in-time snapshots of dirty EditorSession buffers written by DraftAutoSaver every 5 seconds. The editor_drafts_prune trigger removes rows older than 24 hours whose editor_session_id has no recent snapshot (orphan pruning). Reference: ADR-0030, resource_browser bounded context."
}

Table cluster_mutation_audit {
  id varchar [pk, note: "UUIDv7."]
  cluster_id varchar [not null, note: "UUIDv7 of the target cluster. No FK."]
  verb varchar [not null, note: "'apply' | 'patch' | 'delete' | 'scale' | 'rollout-restart' | 'create'"]
  gvk_group varchar [not null, note: "API group. Empty string for core/v1 resources."]
  gvk_version varchar [not null, note: "API version, e.g. 'v1' | 'apps/v1'."]
  gvk_kind varchar [not null, note: "Resource kind, e.g. 'Deployment' | 'Pod' | 'Secret'."]
  namespace varchar [null, note: "Namespace. Null for cluster-scoped resources."]
  resource_name varchar [not null, note: "Kubernetes metadata.name of the target resource."]
  manifest_digest varchar [not null, note: "SHA-256 hex of the submitted manifest payload. Empty string for non-manifest verbs (delete, scale)."]
  confirmation_token varchar [not null, note: "UUIDv7 issued by the confirmation modal. Proves the operator acknowledged the mutation."]
  confirmation_issued_at_seconds bigint [not null, note: "Unix epoch seconds when the confirmation token was issued. Used to detect stale tokens."]
  double_confirmed boolean [not null, default: false, note: "True after the second confirmation step for destructive verbs."]
  requested_at varchar [not null, note: "RFC 3339. When the mutation was dispatched to the Kubernetes API."]
  response_resource_version varchar [null, note: "resourceVersion returned by the API server on success. Null on failure."]
  result varchar [not null, note: "'success' | 'conflict' | 'failed'"]
  error_code varchar [null, note: "HTTP or Kubernetes status code as a string on failure, e.g. '409' | '403'."]
  error_message text [null, note: "API server error body. MUST NOT contain credential material."]
  previous_entry_digest varchar [not null, note: "SHA-256 hex of the previous row's canonical serialised form. Empty string for the first row in the table. Computed and verified in app code; the audit_chain_check trigger enforces append-only but not cryptographic verification (SQLite lacks SHA-256 functions natively)."]

  Indexes {
    (cluster_id, requested_at) [name: "idx_mutation_audit_cluster_time"]
  }

  Note: "Append-only ledger of every operator-initiated mutation to a Kubernetes cluster. Rows are guarded by two SQLite triggers (cluster_mutation_audit_no_update, cluster_mutation_audit_no_delete) defined in policies/audit-trigger.sql. The previous_entry_digest field enables offline chain verification. Reference: ADR-0012, ADR-0010."
}

Table secret_reveal_audit {
  id varchar [pk, note: "UUIDv7."]
  cluster_id varchar [not null, note: "UUIDv7 of the cluster whose Secret was accessed. No FK — cluster registry lives outside SQLite."]
  namespace varchar [not null, note: "Namespace of the Secret. Required (Secret is a namespaced kind)."]
  secret_name varchar [not null, note: "Kubernetes metadata.name of the Secret."]
  secret_type varchar [not null, note: "The Secret's type field, e.g. 'kubernetes.io/dockerconfigjson' | 'kubernetes.io/tls' | 'Opaque' | 'kubernetes.io/basic-auth' | 'kubernetes.io/ssh-auth' | 'bootstrap.kubernetes.io/token' | custom string. Stored verbatim from the API server."]
  key_name varchar [not null, note: "The specific key in the Secret's data map that was accessed. Examples: '.dockerconfigjson', 'tls.crt', 'tls.key', '.dockerconfigjson.auths.registry-io.password'. The dotted-suffix form encodes deep reveal inside a parsed dockerconfigjson auths map (ADR-0063 §Special type parsers)."]
  action varchar [not null, note: "'reveal' | 'hide' | 'clipboard-copy' | 'auto-hide'. reveal: operator explicitly clicked the eye icon. hide: operator explicitly clicked the eye icon again. clipboard-copy: decoded value was written to NSPasteboard.general. auto-hide: the 60-second focus-loss timer fired."]
  user_identifier varchar [not null, note: "NSUserName() at the time of the action. On single-user systems this is the macOS short username; on multi-user systems this is the active session's user."]
  requested_at varchar [not null, note: "RFC 3339. When the action occurred."]
  previous_entry_digest varchar [not null, note: "64-character lowercase HMAC-SHA256 hex linking to the prior row in this table. Empty string for the first row. Computed and verified in app code by AuditChainKeyManager (ADR-0047) using the same Keychain-stored key as cluster_mutation_audit. Independent chain — secret_reveal_audit links to its own prior row, not to cluster_mutation_audit rows."]
  entry_digest varchar [not null, note: "64-character lowercase HMAC-SHA256 hex of this entry's canonical serialised form. Computed in app code; the audit_chain_check trigger pattern (see policies/audit-trigger.sql) enforces append-only behaviour for this table."]

  Indexes {
    (cluster_id, requested_at) [name: "idx_secret_reveal_audit_cluster_time"]
    (namespace, secret_name) [name: "idx_secret_reveal_audit_secret"]
  }

  Note: "Append-only ledger of every privileged Secret data access (reveal, hide, clipboard-copy, auto-hide). MUST NOT contain decoded Secret values — only the access metadata. Chained independently from cluster_mutation_audit using the same AuditChainKeyManager (ADR-0047). Rows are guarded by triggers analogous to cluster_mutation_audit (no UPDATE, no DELETE). Retention policy is deferred to a follow-up ADR (ADR-0063 §Followups). Reference: ADR-0063, ADR-0047, ADR-0012, resource_browser bounded context."
}

Table mcp_wire_log {
  id varchar [pk, note: "UUIDv7."]
  session_id varchar [not null, note: "UUIDv7. FK to the owning chat session. Delete action: cascade (see Ref block at end of file)."]
  direction varchar [not null, note: "'inbound' | 'outbound'"]
  payload_redacted text [not null, note: "MCP wire frame with secrets scrubbed per the redaction policy (ADR-0027). Hard-capped at 256 KiB; truncated beyond that limit."]
  created_at varchar [not null, note: "RFC 3339."]

  Indexes {
    (session_id, created_at) [name: "idx_mcp_wire_log_session_time"]
  }

  Note: "Low-level MCP protocol trace for debugging and diagnostics. Every frame is redacted before storage (ADR-0027 patterns). The payload_redacted column is capped at 256 KiB to bound storage growth. Rows are not automatically pruned — they age out with the owning chat session. Reference: ADR-0009, ADR-0027."
}

Table trusted_exec_plugins {
  command_path varchar [pk, note: "Absolute path to the exec plugin binary, e.g. '/usr/local/bin/kubelogin'."]
  kubeconfig_origin varchar [not null, note: "Absolute path of the kubeconfig file that declares this plugin, or 'builtin'."]
  approved_at varchar [not null, note: "RFC 3339. When the operator approved this plugin."]
  approved_by_user_id varchar [not null, note: "Platform user identifier at approval time, or the literal string 'local-user' on single-user systems."]

  Note: "Registry of exec-plugin binaries the operator has explicitly approved to run. The cluster_connectivity bounded context consults this table before executing any kubeconfig exec plugin. Approval is shown to the operator on first encounter and persists across relaunches. Reference: ADR-0003, ADR-0018, cluster_connectivity bounded context."
}

// ---------------------------------------------------------------------------
// Explicit referential integrity (delete actions)
// ---------------------------------------------------------------------------

Ref: chat_sessions.provider_profile_id > provider_profiles.id [delete: set null]
Ref: chat_messages.session_id > chat_sessions.id [delete: cascade]
Ref: mcp_wire_log.session_id > chat_sessions.id [delete: cascade]

// ---------------------------------------------------------------------------
// Logical grouping
// ---------------------------------------------------------------------------

TableGroup local_persistence {
  schema_migrations
  provider_profiles
  chat_sessions
  chat_messages
  cluster_analysis_cache
  operator_preferences
  editor_drafts
  cluster_mutation_audit
  secret_reveal_audit
  mcp_wire_log
  trusted_exec_plugins
}
