person "==Kubernetes Operator\n<size:16>[Person]</size>\n\nWorkstation user managing one or more Kubernetes clusters and interacting with the in-app assistant." <<Element-RWxlbWVudCxQZXJzb24=>> as KubernetesOperator
rectangle "==K8sManager\n<size:16>[Software System]</size>\n\nmacOS-native Kubernetes manager." <<Element-RWxlbWVudA==>> as K8sManager
rectangle "==Kubeconfig File\n<size:16>[Software System]</size>\n\nUser-managed YAML at KUBECONFIG or ~/.kube/config." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as KubeconfigFile
rectangle "==Kubernetes API Server\n<size:16>[Software System]</size>\n\nRemote cluster API endpoint (multi-cluster). 1.31+ for WebSocket exec and portforward." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as KubernetesAPIServer
rectangle "==Anthropic Messages API\n<size:16>[Software System]</size>\n\nAnthropic-hosted LLM endpoint with SSE streaming and tool_use blocks." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as AnthropicMessagesAPI
rectangle "==OpenAI API\n<size:16>[Software System]</size>\n\nOpenAI-hosted Chat Completions / Responses endpoints." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as OpenAIAPI
rectangle "==OpenAI-Compatible Endpoint\n<size:16>[Software System]</size>\n\nLocal or hosted server speaking the OpenAI API surface (Ollama, LM Studio, vLLM, OpenRouter)." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as OpenAICompatibleEndpoint
rectangle "==AWS STS\n<size:16>[Software System]</size>\n\nAWS Security Token Service for GetCallerIdentity presign and AssumeRole(WithWebIdentity)." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as AWSSTS
rectangle "==Google OAuth and STS\n<size:16>[Software System]</size>\n\nOAuth2 token endpoint and Workload Identity Federation STS endpoint." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as GoogleOAuthandSTS
rectangle "==Microsoft Entra ID / Azure AD\n<size:16>[Software System]</size>\n\nOAuth2 endpoints for device flow, service principal, Managed Identity, Workload Identity Federation." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as MicrosoftEntraIDAzureAD
rectangle "==OIDC Identity Provider\n<size:16>[Software System]</size>\n\nGeneric OIDC issuer (Keycloak, Auth0, Okta, custom) with discovery and JWKS." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as OIDCIdentityProvider
rectangle "==Prometheus Server\n<size:16>[Software System]</size>\n\nIn-cluster Prometheus (kube-prometheus-stack typical) exposing /api/v1/query, /api/v1/query_range, /api/v1/series." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as PrometheusServer
rectangle "==Custom Exec Credential Plugin\n<size:16>[Software System]</size>\n\nExternal binary printing an ExecCredential JSON for kubeconfig exec blocks without a native adapter." <<Element-RWxlbWVudCxFeHRlcm5hbA==>> as CustomExecCredentialPlugin

K8sManager --> PrometheusServer <<Relationship-UmVsYXRpb25zaGlw>> : "HTTPS query and query_range"
K8sManager --> AnthropicMessagesAPI <<Relationship-UmVsYXRpb25zaGlw>> : "POST /v1/messages with SSE streaming"
K8sManager --> OpenAIAPI <<Relationship-UmVsYXRpb25zaGlw>> : "POST chat completions / responses with SSE streaming"
K8sManager --> OpenAICompatibleEndpoint <<Relationship-UmVsYXRpb25zaGlw>> : "POST OpenAI-compatible endpoints"
KubernetesOperator --> K8sManager <<Relationship-UmVsYXRpb25zaGlw>> : "Switches contexts, browses resources, edits YAML, opens terminals, configures providers, chats with assistant, watches metrics"
K8sManager --> KubeconfigFile <<Relationship-UmVsYXRpb25zaGlw>> : "Reads YAML"
K8sManager --> KubernetesAPIServer <<Relationship-UmVsYXRpb25zaGlw>> : "HTTPS over pooled connections (ADR-0007)"
K8sManager --> AWSSTS <<Relationship-UmVsYXRpb25zaGlw>> : "POST /v1/STS GetCallerIdentity (presigned URL)"
K8sManager --> GoogleOAuthandSTS <<Relationship-UmVsYXRpb25zaGlw>> : "POST /token + STS token exchange"
K8sManager --> MicrosoftEntraIDAzureAD <<Relationship-UmVsYXRpb25zaGlw>> : "OAuth2 device flow / service principal / Managed Identity"
K8sManager --> OIDCIdentityProvider <<Relationship-UmVsYXRpb25zaGlw>> : "Authorization Code + PKCE + JWKS"
K8sManager --> CustomExecCredentialPlugin <<Relationship-UmVsYXRpb25zaGlw>> : "Spawns and parses ExecCredential JSON"

@enduml