*~
*.bak
*.swp
*.swo

# Local environment
.env
.env.local
*.local

# Logs
*.log
logs/

# Apple notarization / spec tooling output
*.tar.gz
*.zip
notarization-*.json

# Audit reports — generated locally, not part of the canonical spec
audit-report-*.md

# Spec framework workspace caches (if rendered locally)
docs/arch/.spec-cache/
docs/arch/.render-output/

# Vale — downloaded style packages (vale sync; not committed)
.vale/styles/
